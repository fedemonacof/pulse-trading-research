# ============================================================ PULSE
# Copia questo file in .env e compila le chiavi. Il file .env non va mai condiviso né caricato su git.

# --- Chiavi ---
ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Paper o soldi veri ---
# Il bot si rifiuta di partire se l'indirizzo non è quello paper, a meno che tu non approvi esplicitamente:
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Per i soldi veri servono TUTTE E TRE: indirizzo live, LIVE_TRADING=true e la frase esatta
# ALPACA_BASE_URL=https://api.alpaca.markets
# LIVE_TRADING=true
# LIVE_CONFIRMATION=HO_CAPITO_CHE_POSSO_PERDERE_SOLDI_VERI

# --- Universo e cervello ---
SYMBOLS=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,GOOGL,META,AVGO,JPM,V,UNH,XOM,COST
USE_COMMITTEE=true
CLAUDE_MODEL=claude-opus-5-5
ANALYST_EFFORT=medium
MANAGER_EFFORT=high
DATA_FEED=iex
DEBATE_ROUNDS=1
WEB_RESEARCH=true
FREE_DATA=true

# --- Ritmo ---
TICK_SECONDS=60
REFLEX_MINUTES=15
COMMITTEE_MINUTES=30
TRIGGER_MOVE_PCT=0.015
# Lo scheduler resta spento finché non hai visto e approvato il backtest
SCHEDULER_ENABLED=false

# --- Risk layer PULSE (applicato dal codice prima di ogni ordine: nessun modello lo può superare) ---
MAX_POSITION_PCT=0.05
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.02
NO_TRADE_FIRST_MINUTES=5
STOP_LOSS_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=3.0

# --- Protezioni aggiuntive (stile freqtrade) ---
TRAILING_ATR_MULT=2.5
TRAILING_ACTIVATION_ATR=1.5
MIN_CONFIDENCE=0.65
MAX_TRADES_PER_DAY=20
ALLOW_SHORT=false
MAX_DRAWDOWN_PCT=0.15
COOLDOWN_MINUTES=120
STOPLOSS_GUARD_COUNT=3
STOPLOSS_GUARD_HOURS=24
STOPLOSS_GUARD_PAUSE_HOURS=12

# --- Telegram (opzionale): notifiche e comandi /status /lezioni /kill /resume ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Core + satellite ---
# Il core (SPY) tiene tutto il capitale che il satellite PULSE non usa: il conto resta investito ~al 100%
# e batte SPY solo se le scommesse del satellite rendono più di SPY.
CORE_ENABLED=true
CORE_SYMBOL=SPY
CORE_CASH_BUFFER_PCT=0.03
CORE_REBALANCE_BAND_PCT=0.02
# Perdita giornaliera (MAX_DAILY_LOSS_PCT) e drawdown si misurano sul SATELLITE, non sul core:
SATELLITE_MAX_DRAWDOWN_PCT=0.05

# --- Universo del satellite in ombra ---
# top100: i 100 membri attuali dell'S&P 500 con più volume in dollari a 60 giorni, ricalcolati ogni mese.
# È l'ombra che conta per la regola di riattivazione. "fixed" = i 15 titoli di SYMBOLS (solo per confronto).
SHADOW_UNIVERSE=top100
SHADOW_MEMBERS_CSV=data/sp500/components.csv

# --- Report in avanti (python main.py forward) ---
# Data limite di addestramento del modello del comitato: contano solo i voti successivi.
COMMITTEE_CUTOFF=2026-07-01
